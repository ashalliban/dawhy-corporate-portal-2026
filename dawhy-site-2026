                        <li>Frequently Asked Questions</li>
                    </ul>
                </div>
            </div>
        </section>

        <section id="settlement" class="content-panel">
            <h2>Secure Retainer <span>Settlement Portal</span></h2>
            <p class="panel-intro">Direct API access to regional and global clearing networks.</p>

            <div class="checkout-box">
                <div class="method-flex">
                    <div id="card-mpesa" class="method-card active" onclick="setMethod('mpesa')">
                        🇰🇪 M-Pesa Express
                    </div>
                    <div id="card-payoneer" class="method-card" onclick="setMethod('payoneer')">
                        🌐 Payoneer Global
                    </div>
                </div>

                <div class="form-group">
                    <label for="clientRef">Customer Mobile or Reference</label>
                    <input id="clientRef" type="text" placeholder="Enter mobile number or client ref" />
                </div>

                <div class="form-group">
                    <label for="amount">Settlement Capital Volume</label>
                    <input id="amount" type="number" placeholder="Enter amount" />
                </div>

                <button class="btn-submit" onclick="executeSecurePush()">Initialize Encrypted Gateway</button>
            </div>
        </section>
    </main>

    <footer>
        <div class="footer-brand">
            <strong>DAWHY PARTNERS</strong>
        </div>

        <div class="footer-desc">
            Architecting certainty in global multi-jurisdictional trade corridors.
        </div>

        <div>
            © 2026 DAWHY PARTNERS. Global operations, RegTech automation protocols, and technical due diligence modules map securely across EMEA infrastructure channels via serverless architecture.
        </div>
    </footer>

    <script>
        function switchTab(evt, tabId) {
            document.querySelectorAll('.content-panel').forEach(panel => {
                panel.classList.remove('active');
            });

            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active');
            });

            const targetPanel = document.getElementById(tabId);
            if (targetPanel) {
                targetPanel.classList.add('active');
            }

            evt.currentTarget.classList.add('active');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        let activePaymentMethod = 'mpesa';

        function setMethod(method) {
            activePaymentMethod = method;

            const mpesaCard = document.getElementById('card-mpesa');
            const payoneerCard = document.getElementById('card-payoneer');

            if (mpesaCard) {
                mpesaCard.classList.toggle('active', method === 'mpesa');
            }

            if (payoneerCard) {
                payoneerCard.classList.toggle('active', method === 'payoneer');
            }
        }

        function executeSecurePush() {
            const phoneInput = document.getElementById('clientRef').value;
            const amountInput = document.getElementById('amount').value;

            if (!phoneInput || !amountInput) {
                return alert('Execution aborted: Parameters missing.');
            }

            alert('Routing transactional token pipeline dynamically...');
        }
    </script>
</body>
</html>
